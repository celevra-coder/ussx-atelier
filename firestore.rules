rules_version = '2';

// Public website can create registrations/inquiries, but nobody can read,
// update or delete them through the client SDK. Read them from the Firebase
// Console or an authenticated admin tool instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /inquiries/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
